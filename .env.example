# Copy to .env (not versioned) and fill in to write the knowledge graph to Neo4j (scripts/08_knowledge_graph.py)
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password>
# EnergyPlus 24.2 installation folder (default C:\EnergyPlusV24-2-0)
ENERGYPLUS_DIR=C:\EnergyPlusV24-2-0
